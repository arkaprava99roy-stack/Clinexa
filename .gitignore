# --- Secrets / env files ---
.env
.env.local
.env.production
.env.development
backend/.env
frontend/.env
**/.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.log
*.pot
.mypy_cache/
.ruff_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ---
*.dockerignore

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.idea/
.vscode/settings.json
*.swp
*.swo

# --- Supabase local ---
supabase/.temp/
supabase/functions/.cache/
